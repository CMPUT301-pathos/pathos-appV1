<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATE EVENT POSTER"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/iv_edit_poster_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Current event poster" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_select_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="SELECT NEW POSTER" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_save_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="SAVE POSTER" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_remove_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:backgroundTint="#B00020"
            android:text="REMOVE POSTER"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>