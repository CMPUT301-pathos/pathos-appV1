<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#40FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event Name"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_private_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 PRIVATE"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#801A1A2E"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_event_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#DDDDDD"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_event_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meta"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:drawableStart="@android:drawable/ic_dialog_map"
            android:drawablePadding="4dp"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lottery_criteria"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="View Lottery Criteria"
            android:textSize="11sp"
            android:layout_marginTop="10dp"
            android:layout_gravity="end"
            app:icon="@drawable/ic_clipboard"
            app:iconPadding="6dp"
            app:iconSize="14dp"
            app:iconTint="#FFFFFF"
            app:backgroundTint="#40FFFFFF"
            app:cornerRadius="16dp" />

        <LinearLayout
            android:id="@+id/layout_organizer_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_qr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="See QR"
                android:textSize="11sp"
                app:backgroundTint="#40FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Edit"
                android:textSize="11sp"
                app:backgroundTint="#40FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_geo_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Geo"
                android:textSize="11sp"
                app:backgroundTint="#40FFFFFF"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite_entrants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Invite"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="#40FFFFFF"
                app:cornerRadius="12dp" />


        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>