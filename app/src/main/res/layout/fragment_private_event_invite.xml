<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_header">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_invite_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invite Entrants"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search by name, email, or phone number"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp" />

    <!-- Search bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/et_invite_search"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Search entrants..."
            android:textColor="#FFFFFF"
            android:textColorHint="#CCFFFFFF"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_filter_input"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_invite_search"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:text="SEARCH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            app:backgroundTint="#1A1A2E"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Results -->
    <TextView
        android:id="@+id/tv_invite_results_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No entrants found."
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/container_invite_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>