<?xml version="1.0" encoding="utf-8"?>
<!-- author : hasratsinghchauhan -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#19FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#19FFFFFF">

        <!-- Top Row: Sender and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvLogSender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="From: Organizer Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvLogStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="sent"
                android:textSize="11sp"
                android:background="#19FFFFFF"
                android:background="@android:color/black"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Recipient -->
        <TextView
            android:id="@+id/tvLogRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To: User Name"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <!-- Event (if available) -->
        <TextView
            android:id="@+id/tvLogEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Event: Swimming Lessons"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="8dp" />

        <!-- Bottom Row: Type and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLogType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lottery Won"
                android:textSize="12sp"
                android:textColor="@android:color/black"

                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />

            <TextView
                android:id="@+id/tvLogTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mar 10, 14:30"
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Preview of message (optional) -->
        <TextView
            android:id="@+id/tvLogPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You won the lottery for Swimming Lessons!"
            android:textSize="13sp"
            android:textColor="@android:color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>