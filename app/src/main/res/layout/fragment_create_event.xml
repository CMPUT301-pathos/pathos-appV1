<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT CREATION"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/et_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name of Event"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_event_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Event Description/Link"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_event_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_event_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capacity (#) (optional)"
            android:inputType="number"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_selected_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category: All"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PICK CATEGORY"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_event_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registration Start (YYYY-MM-DD)"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_event_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registration End (YYYY-MM-DD)"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:layout_marginBottom="18dp" />

        <ImageView
            android:id="@+id/iv_event_poster_preview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Event poster preview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_event_poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ADD EVENT POSTER" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUBLISH (GENERATE QR)" />

    </LinearLayout>
</ScrollView>