<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCommentContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="16dp"
        android:background="#F5F5F5"
        android:padding="12dp"
        android:alpha="0.9" />

    <TextView
        android:id="@+id/tvCommentAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason for deletion:"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etDeletionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter reason for deletion..."
        android:minLines="2"
        android:maxLines="4"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background" />

    <CheckBox
        android:id="@+id/cbPolicyViolation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This comment violates app policy"
        android:paddingTop="16dp" />

</LinearLayout>
