<?xml version="1.0" encoding="utf-8"?>
<!-- AI message bubble — left aligned, light surface -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="6dp"
    android:paddingTop="6dp"
    android:gravity="start">

    <!-- Avatar circle -->
    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="AI"
        android:textColor="#7B8FD4"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/bg_ai_avatar"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp" />

    <!-- Bubble -->
    <TextView
        android:id="@+id/tv_message_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_bubble_ai"
        android:padding="12dp"
        android:textColor="#1A1A2E"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.5" />

</LinearLayout>