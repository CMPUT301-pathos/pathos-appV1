<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile_gradient_background_forstyledlayout"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with back button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back_arrow_forstyledlayout"
                android:padding="8dp"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/forestyled_text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit Profile"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/forestyled_text_primary"
                android:gravity="center"
                android:layout_gravity="center" />

            <!-- Empty view for balance -->
            <View
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Profile Image with edit icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_profile_placeholder_forstyledlayout"
                android:background="@drawable/circular_white_background_forstyledlayout"
                android:padding="20dp"
                android:layout_centerHorizontal="true"
                android:elevation="4dp" />

            <ImageView
                android:id="@+id/edit_photo_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_profile_placeholder_forstyledlayout"
                android:background="@drawable/circular_white_background_forstyledlayout"
                android:padding="6dp"
                android:layout_toEndOf="@id/profile_image"
                android:layout_alignBottom="@id/profile_image"
                android:layout_marginStart="-20dp"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true"
                android:backgroundTint="@color/forestyled_accent_primary"
                app:tint="@color/forestyled_dark_background_start" />
        </RelativeLayout>

        <!-- Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/InputStyle_ForStyledLayout"
            android:layout_marginBottom="16dp"
            app:endIconMode="clear_text"
            app:placeholderText="Enter your full name"
            app:placeholderTextColor="@color/forestyled_text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Full Name"
                android:textColor="@color/forestyled_text_primary"
                android:textColorHint="@color/forestyled_text_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/InputStyle_ForStyledLayout"
            android:layout_marginBottom="16dp"
            app:endIconMode="clear_text"
            app:placeholderText="Enter your email address"
            app:placeholderTextColor="@color/forestyled_text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:textColor="@color/forestyled_text_primary"
                android:textColorHint="@color/forestyled_text_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/InputStyle_ForStyledLayout"
            android:layout_marginBottom="32dp"
            app:endIconMode="clear_text"
            app:placeholderText="Enter your phone number"
            app:placeholderTextColor="@color/forestyled_text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone Number"
                android:inputType="phone"
                android:textColor="@color/forestyled_text_primary"
                android:textColorHint="@color/forestyled_text_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/button_save"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="SAVE CHANGES"
                style="@style/ButtonStyle_ForStyledLayout"
                android:backgroundTint="@color/forestyled_accent_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/button_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="CANCEL"
                style="@style/ButtonStyle_ForStyledLayout"
                android:backgroundTint="@color/forestyled_dark_elevated"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Optional hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* All fields are required"
            android:textColor="@color/forestyled_text_hint"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>