<?xml version="1.0" encoding="utf-8"?>
<!--
fragment_profile.xml
author: Kenneth Joseph
Purpose: Combined Account Info UI.
Includes:
- Name/email/phone inputs + Save Changes
- Notification opt-out switch
- "View Event History" button
- Account security (Logout/Delete)
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_header"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/profileRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvAccountInfoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="ACCOUNT INFO"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_profile_placeholder_forstyledlayout"
            app:civ_border_width="2dp"
            app:civ_border_color="#FFFFFF"
            app:civ_circle_background_color="#D3D3D3"
            />

        <TextView
            android:id="@+id/change_photo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Change Photo"
            android:textColor="#80CBC4"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Edit Info section -->
        <TextView
            android:id="@+id/tvEditInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Info"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:hint="Enter your name"
            android:layout_marginBottom="12dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="12dp" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone Number (Optional)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/edit_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:hint="Enter your phone number"
            android:inputType="phone"
            android:layout_marginBottom="16dp" />

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_profile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#43A047"
            app:cornerRadius="18dp"
            app:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Notification opt-out (placeholder until wired) -->
        <TextView
            android:id="@+id/tvNotificationOptOutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvNotificationOptOutDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Want to opt out of notifications?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_opt_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opt out"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!--  Added: Event History button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_event_history"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:text="View Event History"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#00000000"
            app:strokeColor="#CCFFFFFF"
            app:strokeWidth="2dp"
            app:cornerRadius="18dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Account security -->
        <TextView
            android:id="@+id/tvAccountSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account Security"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_delete_account"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Delete Account"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#C62828"
                app:cornerRadius="18dp"
                app:elevation="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>