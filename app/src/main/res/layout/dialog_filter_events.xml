<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_header_rounded"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FILTER EVENTS"
        android:textColor="#1A1A2E"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="20dp" />

    <!-- Category -->
    <TextView
        android:id="@+id/tv_filter_category_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category: All"
        android:textColor="#1A1A2E"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_filter_pick_category"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="PICK CATEGORY"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#201A1A2E"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Location -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textColor="#1A1A2E"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_filter_location"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. Edmonton"
        android:textColor="#1A1A2E"
        android:textColorHint="#881A1A2E"
        android:textSize="13sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_filter_input"
        android:layout_marginBottom="16dp" />

    <!-- Max Capacity -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Max Waitlist Capacity (0 = any)"
        android:textColor="#1A1A2E"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/et_filter_max_capacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. 100"
        android:textColor="#1A1A2E"
        android:textColorHint="#881A1A2E"
        android:textSize="13sp"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_filter_input"
        android:layout_marginBottom="16dp" />

    <!-- Date -->
    <TextView
        android:id="@+id/tv_filter_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show events after: Any date"
        android:textColor="#1A1A2E"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter_pick_date"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="PICK DATE"
            android:textSize="12sp"
            android:textColor="#1A1A2E"
            app:backgroundTint="#201A1A2E"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter_clear_date"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="CLEAR DATE"
            android:textSize="12sp"
            android:textColor="#1A1A2E"
            app:backgroundTint="#20000000"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- Open only checkbox -->
    <CheckBox
        android:id="@+id/cb_filter_open_only"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show only open registration"
        android:textColor="#1A1A2E"
        android:textSize="13sp"
        android:buttonTint="#1A1A2E"
        android:layout_marginBottom="24dp" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter_clear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="CLEAR"
            android:textColor="#1A1A2E"
            android:textSize="13sp"
            app:backgroundTint="#20000000"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter_apply"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="APPLY"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#1A1A2E"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>