<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_header">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvOrgTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORGANIZER DASHBOARD"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/tvCreateEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CREATE AN EVENT"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingBottom="10dp" />

        <Button
            android:id="@+id/btn_create_event"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="CREATE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#1A1A2E"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR EVENTS"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:layout_marginTop="20dp" />

    </LinearLayout>

    <!-- Event list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_my_events_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You haven't created any events yet."
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_my_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>