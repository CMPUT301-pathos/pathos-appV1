<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_organizer_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event Name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:letterSpacing="0.05"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Waitlisted -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAIT-LISTED ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cb_require_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Require geolocation to join"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_lottery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="RUN LOTTERY DRAW"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="#1A1A2E"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <LinearLayout
                android:id="@+id/container_waitlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_waitlist_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No entrants on the waitlist yet."
                android:textColor="#000000"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Enrolled -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHOSEN ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_enrolled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_enrolled_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No entrants enrolled yet."
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>