<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_organizer_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event Name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:letterSpacing="0.05"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Waiting (WAITING status) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAITING ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_lottery"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="RUN LOTTERY DRAW"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:backgroundTint="#1A1A2E"
                app:cornerRadius="12dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <LinearLayout
                android:id="@+id/container_waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_waiting_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No entrants waiting."
                android:textColor="#000000"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Invited (US 02.06.01) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVITED ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_invited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_invited_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No invited entrants."
                android:textColor="#000000"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Enrolled (US 02.06.03) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENROLLED ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_enrolled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_enrolled_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No enrolled entrants."
                android:textColor="#000000"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Cancelled (US 02.06.02) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCELLED ENTRANTS"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_cancelled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_cancelled_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No cancelled entrants."
                android:textColor="#000000"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>