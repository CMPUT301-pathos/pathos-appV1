- Events (nav_scan)  [repurposed placeholder for QR scan + event list]
- Notifications (nav_notifications)
- Profile (nav_profile)
-->

<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/nav_home"
